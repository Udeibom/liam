{
  "expo": {
    "name": "LIAN",
    "slug": "lian",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "scheme": "lian",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.lian.skincompanion"
    },
    "android": {
      "package": "com.lian.skincompanion",
      "adaptiveIcon": {
        "backgroundColor": "#0F1923",
        "foregroundImage": "./assets/adaptive-icon.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "experiments": {
      "typedRoutes": true
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-secure-store",
      "expo-font",
      "expo-splash-screen",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow LIAN to access your camera to capture skin photos and product labels.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow LIAN to access your photos to upload skin scans and product images."
        }
      ]
    ]
  }
}
