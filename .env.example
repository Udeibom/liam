# Copy this file to .env.local and fill in your values.
# EXPO_PUBLIC_ variables are safe to embed in the client bundle (they are public keys).
# Never put secret API keys in EXPO_PUBLIC_ variables — those go in Supabase Edge Function secrets.

# ── Supabase (client-side, safe to expose) ──────────────────────────────────
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# ── Secret keys ─────────────────────────────────────────────────────────────
# These NEVER go in .env.local or get committed to git.
# Set them in Supabase Dashboard → Edge Functions → Manage secrets, or via CLI:
#
#   supabase secrets set GROQ_API_KEY=...
#   supabase secrets set GEMINI_API_KEY=...
#   supabase secrets set YOUCAM_API_KEY=...
#   supabase secrets set YOUCAM_API_SECRET=...
#   supabase secrets set OCRSPACE_API_KEY=...
#
# Where to get each key:
#   Groq:      https://console.groq.com  (free tier, no credit card)
#   Gemini:    https://aistudio.google.com  (free tier, 250 req/day)
#   YouCam:    https://yce.perfectcorp.com/ai-api  (1000 free units via hackathon)
#   OCR.space: https://ocr.space/OCRAPI  (free tier, 25k req/month)
